# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# ─── Base de datos (MySQL 8) ────────────────────────────────────────────────
DATABASE_URL=mysql://sismocol:cambia-esta-clave@localhost:3306/sismocol
# Solo para `prisma migrate dev`: base vacía que Prisma usa para comparar
SHADOW_DATABASE_URL=mysql://sismocol:cambia-esta-clave@localhost:3306/sismocol_shadow

# ─── Autenticación ──────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con: npm run secreto
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ─── Servicio analítico (FastAPI) ───────────────────────────────────────────
ANALYTICS_URL=http://127.0.0.1:8000
# Mismo valor que ANALYTICS_TOKEN en Analytics/.env. Mínimo 32 caracteres.
ANALYTICS_TOKEN=
UPLOAD_MAX_MB=25

# ─── MQTT (Mosquitto) ───────────────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=sismocol-api
MQTT_PASSWORD=
MQTT_TOPIC_SIMULACION=sismos/simulacion
MQTT_TOPIC_ESTADO=sismos/estado
MQTT_TOPIC_LATIDO=sismos/latido
MQTT_ACK_TIMEOUT_MS=5000
MQTT_LATIDO_TIMEOUT_MS=30000

# ─── Seed (solo se leen al correr `npm run db:seed`) ────────────────────────
SEED_ADMIN_NOMBRE=Administrador SismoCol
SEED_ADMIN_CORREO=admin@sismocol.local
SEED_ADMIN_CONTRASENA=
SEED_USUARIO_NOMBRE=Usuario de prueba
SEED_USUARIO_CORREO=usuario@sismocol.local
SEED_USUARIO_CONTRASENA=
SEED_ESP32_NOMBRE=Prototipo ESP32
