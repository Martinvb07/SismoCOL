# Conexión a MySQL (misma base que la API; driver PyMySQL)
DATABASE_URL=mysql+pymysql://sismocol:cambia-esta-clave@localhost:3306/sismocol?charset=utf8mb4
# Mismo valor que ANALYTICS_TOKEN en Backend/.env (mínimo 32 caracteres)
ANALYTICS_TOKEN=
ZONA_HORARIA=America/Bogota

# Sincronización diaria con USGS y UNGRD (crontab, hora de Colombia)
CRON_SINCRONIZACION=0 2 * * *
USGS_MAGNITUD_MIN=2.5
HTTP_TIMEOUT_S=120

# Ingesta
MAX_MB_ARCHIVO=25
TAMANO_LOTE_INSERCION=2000
