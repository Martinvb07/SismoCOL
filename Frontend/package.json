{
  "name": "sismocol-frontend",
  "version": "0.1.0",
  "description": "Frontend de SismoCol — React + Vite + Tailwind + D3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
